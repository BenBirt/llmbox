# Local overrides (not committed — e.g. offline registry mirror, proxy workarounds).
try-import %workspace%/.bazelrc.local

# ---- Hermeticity relaxations needed for the v8 crate ----------------------
#
# The v8 crate's build.rs writes files derived from $OUT_DIR and also reads
# RUSTY_V8_ARCHIVE/RUSTY_V8_SRC_BINDING_PATH from the environment to locate
# the prebuilt static library checked in under third_party/v8/.
#
# Running without the Linux sandbox lets the build script access those
# absolute paths on disk (set by direnv automatically via .envrc).
#
# RUSTY_V8_ARCHIVE and RUSTY_V8_SRC_BINDING_PATH must be set in the outer
# environment (direnv handles this automatically via .envrc).

build --strategy=CargoBuildScript=local
build --strategy=CargoBuildScriptRun=local
build --strategy=Rustc=local
build --action_env=RUSTY_V8_ARCHIVE
build --action_env=RUSTY_V8_SRC_BINDING_PATH

# ---- General settings -------------------------------------------------------
# Disk cache for faster incremental builds
build --disk_cache=~/.cache/bazel-disk-cache

# Show test output on failure
test --test_output=errors
