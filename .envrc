# direnv configuration for llmbox
# Run `direnv allow` once to activate.

# Point the v8 crate's build script at the prebuilt artifacts checked in under
# third_party/v8/ so it does not need to fetch anything from the internet.
export RUSTY_V8_ARCHIVE="$PWD/third_party/v8/librusty_v8_release_x86_64-unknown-linux-gnu.a.gz"
export RUSTY_V8_SRC_BINDING_PATH="$PWD/third_party/v8/src_binding_release_x86_64-unknown-linux-gnu.rs"

# Generate .bazelrc.local with the current proxy credentials.
#
# bcr.bazel.build is not in this environment's proxy allowlist, so we use
# raw.githubusercontent.com (the BCR git repo) as the registry instead.
# Bazel 9 ignores JAVA_TOOL_OPTIONS, so proxy credentials and JVM settings
# must be passed as startup flags.  Because the JWT rotates with each session,
# we write them into the gitignored .bazelrc.local so they are always current.
#
# Additional notes:
#   - JDK 8u111+ disables Basic auth for HTTPS CONNECT tunneling by default;
#     jdk.http.auth.tunneling.disabledSchemes= re-enables it.
#   - The proxy performs TLS inspection with "sandbox-egress-production TLS
#     Inspection CA".  The system's Java cacerts at /etc/ssl/certs/java/cacerts
#     already trusts it; we override Bazel's bundled JDK cacerts to use it.
#
# If you are in an environment without GLOBAL_AGENT_HTTP_PROXY, delete
# .bazelrc.local or replace it with your own overrides.
if [ -n "${GLOBAL_AGENT_HTTP_PROXY:-}" ]; then
  _p="${GLOBAL_AGENT_HTTP_PROXY#http://}"
  _proxy_userinfo="${_p%@*}"
  _proxy_hostport="${_p##*@}"
  _proxy_host="${_proxy_hostport%:*}"
  _proxy_port="${_proxy_hostport##*:}"
  _proxy_user="${_proxy_userinfo%%:*}"
  _proxy_pass="${_proxy_userinfo#*:}"

  cat > "$PWD/.bazelrc.local" << EOF
# Auto-generated by .envrc — do not edit by hand.
# Regenerate by running: direnv reload

# bcr.bazel.build is not reachable through this environment's proxy.
# raw.githubusercontent.com (the BCR Git repo) serves the same content.
common --registry=https://raw.githubusercontent.com/bazelbuild/bazel-central-registry/main

# Proxy credentials for Bazel's JVM HTTP client (registry + repo-rule
# downloads).  Bazel 9 ignores JAVA_TOOL_OPTIONS; these must be startup flags.
startup --host_jvm_args=-Dhttps.proxyHost=${_proxy_host}
startup --host_jvm_args=-Dhttps.proxyPort=${_proxy_port}
startup --host_jvm_args=-Dhttps.proxyUser=${_proxy_user}
startup --host_jvm_args=-Dhttps.proxyPassword=${_proxy_pass}
startup --host_jvm_args=-Dhttp.proxyHost=${_proxy_host}
startup --host_jvm_args=-Dhttp.proxyPort=${_proxy_port}
startup --host_jvm_args=-Dhttp.proxyUser=${_proxy_user}
startup --host_jvm_args=-Dhttp.proxyPassword=${_proxy_pass}
startup --host_jvm_args=-Dhttp.nonProxyHosts=localhost|127.*|[::1]

# JDK 8u111+ disables Basic auth for HTTPS CONNECT tunneling by default.
startup --host_jvm_args=-Djdk.http.auth.tunneling.disabledSchemes=
startup --host_jvm_args=-Djdk.http.auth.proxying.disabledSchemes=

# The proxy performs TLS inspection; its CA is in the system Java cacerts but
# not in Bazel's bundled JDK cacerts.  Use the system trust store instead.
startup --host_jvm_args=-Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts
startup --host_jvm_args=-Djavax.net.ssl.trustStorePassword=changeit
EOF

  unset _p _proxy_userinfo _proxy_hostport _proxy_host _proxy_port _proxy_user _proxy_pass
fi
